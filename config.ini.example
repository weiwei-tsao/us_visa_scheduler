[PERSONAL_INFO]
; Account and current appointment info from https://ais.usvisa-info.com
USERNAME = account@gmail.com
PASSWORD = account_pass
; Find SCHEDULE_ID in re-schedule page link:
; https://ais.usvisa-info.com/en-am/niv/schedule/{SCHEDULE_ID}/appointment
SCHEDULE_ID = 99999999
; Target Period:
PRIOD_START = 2023-03-20
PRIOD_END = 2023-06-01
; Change "en-ca", based on your embassy Abbreviation in embassy.py list.
YOUR_EMBASSY = en-ca

[CHROMEDRIVER]
; Details for the script to control Chrome
LOCAL_USE = True
; Optional: HUB_ADDRESS is mandatory only when LOCAL_USE = False
HUB_ADDRESS = http://localhost:9515/wd/hub

[BEHAVIOR]
; Headless mode: run without opening a visible browser window
; WARNING: Headless mode may increase detection risk
HEADLESS = False
; Delay between steps (seconds) to mimic human speed
STEP_DELAY = 0.5

[NOTIFICATION]
; Get email notifications via https://sendgrid.com/ (optional)
SENDGRID_API_KEY =
SENDGRID_EMAIL_SENDER =

; Get Telegram notifications via Telegram Bot (optional)
; To get your bot token: Talk to @BotFather on Telegram and create a new bot
; To get your chat ID: Talk to @userinfobot on Telegram or send a message to your bot and check https://api.telegram.org/bot<YourBOTToken>/getUpdates
TELEGRAM_BOT_TOKEN =
TELEGRAM_CHAT_ID =

[TIME]
; Time between retries/checks for available dates (seconds)
; Recommended ranges:
;   Conservative: 111-300 (~18 checks/hour)
;   Moderate: 60-120 (~40 checks/hour)
;   Aggressive: 30-60 (~80 checks/hour, proxy recommended)
RETRY_TIME_L_BOUND = 60
RETRY_TIME_U_BOUND = 120
; Script runtime limit before clean restart (hours)
; 0.75 hours = 45 minutes
WORK_LIMIT_TIME = 0.75
; Ban cooldown is handled by the wrapper script (run_visa.sh), but kept here for reference
BAN_COOLDOWN_TIME = 4

[BAN_DETECTION]
; Graduated ban detection to reduce false positive downtime
; Empty array response is NOT always a ban - could be:
;   - Genuine rate limiting (actual ban)
;   - Embassy has no dates available (false positive)
;   - Temporary server glitch (false positive)

; Cooldown times in MINUTES for graduated response:
; 1st empty response: short wait (default: 5 minutes)
COOLDOWN_FIRST_EMPTY = 5
; 2nd consecutive empty: medium wait (default: 30 minutes)
COOLDOWN_SECOND_EMPTY = 30
; 3rd consecutive empty: long wait (default: 120 minutes / 2 hours)
COOLDOWN_THIRD_EMPTY = 120
; 4th+ consecutive OR HTTP 403/429: exit with ban code (default: 240 minutes / 4 hours)
; This triggers the wrapper script cooldown
COOLDOWN_HARD_BAN = 240
